{
  "name": "websocketConnection",
  "type": "function",
  "runtime": "nodejs20.x",
  "handler": "src/connection.handler",
  "environment": {
    "CONNECTION_TABLE": "VoxShieldConnections",
    "REGION": "us-east-1"
  },
  "permissions": [
    {
      "actions": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:DeleteItem",
        "dynamodb:Scan"
      ],
      "resources": ["arn:aws:dynamodb:*:*:table/VoxShieldConnections"]
    },
    {
      "actions": ["execute-api:ManageConnections"],
      "resources": ["arn:aws:execute-api:*:*:*"]
    }
  ]
}