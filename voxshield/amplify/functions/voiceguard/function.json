{
  "name": "voiceguard",
  "type": "function",
  "runtime": "nodejs20.x",
  "handler": "src/lambda.handler",
  "triggers": {
    "Api": {
      "path": "/voiceguard",
      "method": "post",
      "auth": true
    }
  },
  "environment": {
    "S3_BUCKET_NAME": "voxshield",
    "REGION": "us-east-1"
  }
}