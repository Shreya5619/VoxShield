# WebSocket Configuration
# Get the WebSocket URL from your AWS API Gateway
# Format: wss://{api-id}.execute-api.{region}.amazonaws.com/{stage}

# For Expo apps, environment variables need to be defined in app.json
# or use EXPO_PUBLIC_ prefix in .env file (with expo-config plugin)
EXPO_PUBLIC_WEBSOCKET_URL=wss://your-api-gateway-url.amazonaws.com/prod
